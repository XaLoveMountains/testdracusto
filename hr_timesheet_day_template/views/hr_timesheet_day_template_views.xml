<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_timesheet_day_template_view_form" model="ir.ui.view">
        <field name="name">hr.timesheet.day.template.form</field>
        <field name="model">hr.timesheet.day.template</field>
        <field name="arch" type="xml">
            <form string="Journée type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="ex: Piquet"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="total_hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="project_id"/>
                                    <field name="task_id"/>
                                    <field name="name"/>
                                    <field name="unit_amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_timesheet_day_template_view_list" model="ir.ui.view">
        <field name="name">hr.timesheet.day.template.list</field>
        <field name="model">hr.timesheet.day.template</field>
        <field name="arch" type="xml">
            <list string="Journées types">
                <field name="name"/>
                <field name="employee_ids" widget="many2many_tags" optional="show"/>
                <field name="total_hours" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="hr_timesheet_day_template_view_search" model="ir.ui.view">
        <field name="name">hr.timesheet.day.template.search</field>
        <field name="model">hr.timesheet.day.template</field>
        <field name="arch" type="xml">
            <search string="Journées types">
                <field name="name"/>
                <field name="employee_ids"/>
                <filter name="my_templates" string="Mes journées types"
                        domain="[('employee_ids.user_id', '=', uid)]"/>
                <group>
                    <filter name="group_by_employee" string="Collaborateur"
                            context="{'group_by': 'employee_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_timesheet_day_template_action" model="ir.actions.act_window">
        <field name="name">Journées types</field>
        <field name="res_model">hr.timesheet.day.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_templates': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première journée type
            </p>
            <p>
                Une journée type regroupe un ensemble de lignes (projet,
                tâche, durée) que vous pourrez appliquer en un clic sur un
                jour de votre feuille de temps.
            </p>
        </field>
    </record>
</odoo>
